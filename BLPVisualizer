import sys
from BLP import BLP


def setup_initial_state():
    """Returns a fresh BLP instance loaded with the base assignment criteria."""
    blp = BLP()
    print("\n[System] Initializing Default State...")

    blp.add_subject("alice", "S", "U")
    blp.add_subject("bob", "C", "C")
    blp.add_subject("eve", "U", "U")

    blp.add_object("pub.txt", "U")
    blp.add_object("emails.txt", "C")
    blp.add_object("username.txt", "S")
    blp.add_object("password.txt", "TS")

    return blp


# All 18 test cases
TEST_CASES = {
    # Case 1: Alice reads emails.txt
    1: [
        ("read", "alice", "emails.txt")
    ],

    # Case 2: Alice reads password.txt
    2: [
        ("read", "alice", "password.txt")
    ],

    # Case 3: Eve reads pub.txt
    3: [
        ("read", "eve", "pub.txt")
    ],

    # Case 4: Eve reads emails.txt
    4: [
        ("read", "eve", "emails.txt")
    ],

    # Case 5: Bob reads password.txt
    5: [
        ("read", "bob", "password.txt")
    ],

    # Case 6: Alice reads emails.txt then writes to pub.txt
    6: [
        ("read", "alice", "emails.txt"),
        ("write", "alice", "pub.txt")
    ],

    # Case 7: Alice reads emails.txt then writes to password.txt
    7: [
        ("read", "alice", "emails.txt"),
        ("write", "alice", "password.txt")
    ],

    # Case 8: Alice reads emails.txt, writes to emails.txt,
    # reads username.txt, then writes to emails.txt again
    8: [
        ("read", "alice", "emails.txt"),
        ("write", "alice", "emails.txt"),
        ("read", "alice", "username.txt"),
        ("write", "alice", "emails.txt")
    ],

    # Case 9: Alice reads username.txt, writes to emails.txt,
    # reads password.txt, then writes to password.txt
    9: [
        ("read", "alice", "username.txt"),
        ("write", "alice", "emails.txt"),
        ("read", "alice", "password.txt"),
        ("write", "alice", "password.txt")
    ],

    # Case 10: Alice reads pub.txt and writes to emails.txt;
    # Bob then reads emails.txt
    10: [
        ("read", "alice", "pub.txt"),
        ("write", "alice", "emails.txt"),
        ("read", "bob", "emails.txt")
    ],

    # Case 11: Alice reads pub.txt and writes to username.txt;
    # Bob then reads username.txt
    11: [
        ("read", "alice", "pub.txt"),
        ("write", "alice", "username.txt"),
        ("read", "bob", "username.txt")
    ],

    # Case 12: Alice reads pub.txt and writes to password.txt;
    # Bob then reads password.txt
    12: [
        ("read", "alice", "pub.txt"),
        ("write", "alice", "password.txt"),
        ("read", "bob", "password.txt")
    ],

    # Case 13: Alice reads pub.txt and writes to emails.txt;
    # Eve then reads emails.txt
    13: [
        ("read", "alice", "pub.txt"),
        ("write", "alice", "emails.txt"),
        ("read", "eve", "emails.txt")
    ],

    # Case 14: Alice reads emails.txt and writes to pub.txt;
    # Eve then reads pub.txt
    14: [
        ("read", "alice", "emails.txt"),
        ("write", "alice", "pub.txt"),
        ("read", "eve", "pub.txt")
    ],

    # Case 15: Alice sets her level to S, then reads username.txt
    15: [
        ("set_level", "alice", "S"),
        ("read", "alice", "username.txt")
    ],

    # Case 16: Alice reads emails.txt, sets her level to U,
    # writes to pub.txt, then Eve reads pub.txt
    16: [
        ("read", "alice", "emails.txt"),
        ("set_level", "alice", "U"),
        ("write", "alice", "pub.txt"),
        ("read", "eve", "pub.txt")
    ],

    # Case 17: Alice reads username.txt, sets her level to C,
    # writes to emails.txt, then Eve reads emails.txt
    17: [
        ("read", "alice", "username.txt"),
        ("set_level", "alice", "C"),
        ("write", "alice", "emails.txt"),
        ("read", "eve", "emails.txt")
    ],

    # Case 18: Eve reads pub.txt, then reads emails.txt
    18: [
        ("read", "eve", "pub.txt"),
        ("read", "eve", "emails.txt")
    ]
}


def execute_commands(blp, commands):
    """Execute each command in a test case."""
    for cmd in commands:
        action = cmd[0]

        if action == "read":
            blp.read(cmd[1], cmd[2])

        elif action == "write":
            blp.write(cmd[1], cmd[2])

        elif action == "set_level":
            blp.set_level(cmd[1], cmd[2])

        elif action == "validate":
            blp.validate_levels(cmd[1], cmd[2])


def main():
    print("========================================")
    print(" Bell-LaPadula (BLP) Simulator CLI")
    print("========================================")

    while True:
        print("\nOptions:")
        print("  [1-18] Run a specific test case (1 to 18)")
        print("  [A] Run all test cases sequentially")
        print("  [Q] Quit")

        choice = input("\nEnter choice: ").strip().upper()

        if choice == "Q":
            print("Exiting simulator. Goodbye!")
            sys.exit(0)

        elif choice == "A":
            for case_num in sorted(TEST_CASES.keys()):
                print(f"\n================ CASE #{case_num} ================")

                blp = setup_initial_state()
                execute_commands(blp, TEST_CASES[case_num])
                blp.display_state()

        elif choice.isdigit() and int(choice) in TEST_CASES:
            case_num = int(choice)

            print(f"\n================ CASE #{case_num} ================")

            blp = setup_initial_state()
            execute_commands(blp, TEST_CASES[case_num])
            blp.display_state()

        else:
            print("Invalid input. Please enter a valid case number, 'A', or 'Q'.")


if __name__ == "__main__":
    main()
