import os
import json
import hashlib

HASH_TABLE_FILE = "hash_table.json"


def hash_file(filepath):
    """Calculate the SHA-256 hash of a file."""
    sha256 = hashlib.sha256()

    try:
        with open(filepath, "rb") as file:
            while chunk := file.read(4096):
                sha256.update(chunk)

        return sha256.hexdigest()

    except Exception as e:
        print(f"Error hashing {filepath}: {e}")
        return None


def traverse_directory(directory):
    """Traverse a directory and calculate hashes for all files."""
    hash_table = {}

    for root, directories, files in os.walk(directory):
        for filename in files:
            filepath = os.path.join(root, filename)

            filepath = os.path.abspath(filepath)

            file_hash = hash_file(filepath)

            if file_hash is not None:
                hash_table[filepath] = file_hash

    return hash_table


def generate_table():
    """Generate a new hash table and save it as a JSON file."""
    directory = input("Enter the directory path: ").strip()

    if not os.path.isdir(directory):
        print("Invalid directory path.")
        return

    print("Hashing files...")

    hash_table = traverse_directory(directory)

    with open(HASH_TABLE_FILE, "w") as file:
        json.dump(hash_table, file, indent=4)

    print("Hash table generated")


def validate_hash():
    """Verify files against the hashes stored in the JSON hash table."""
    
    if not os.path.exists(HASH_TABLE_FILE):
        print("Hash table not found. Generate a hash table first.")
        return

    with open(HASH_TABLE_FILE, "r") as file:
        stored_hashes = json.load(file)

    directory = input("Enter the directory path to verify: ").strip()

    if not os.path.isdir(directory):
        print("Invalid directory path.")
        return

    directory = os.path.abspath(directory)

    current_hashes = traverse_directory(directory)

    for filepath, stored_hash in stored_hashes.items():

        if os.path.commonpath([filepath, directory]) != directory:
            continue

        if not os.path.exists(filepath):
            print(f"{filepath} hash is invalid - file has been deleted")
            continue

        current_hash = current_hashes.get(filepath)

        if current_hash == stored_hash:
            print(f"{filepath} hash is valid")
        else:
            print(f"{filepath} hash is invalid")

    for filepath in current_hashes:
        if os.path.commonpath([filepath, directory]) != directory:
            continue

        if filepath not in stored_hashes:
            print(f"{filepath} is a new file")


def main():
    """Display the menu and handle user input."""

    while True:
        print("\nHashing Program")
        print("1. Generate a new hash table")
        print("2. Verify hashes")
        print("3. Exit")

        choice = input("Enter your choice: ").strip()

        if choice == "1":
            generate_table()

        elif choice == "2":
            validate_hash()

        elif choice == "3":
            print("Exiting program.")
            break

        else:
            print("Invalid choice. Please enter 1, 2, or 3.")


if __name__ == "__main__":
    main()
